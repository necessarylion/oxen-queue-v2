{
  "name": "oxen-queue-v2",
  "version": "3.0.0",
  "description": "A resilient worker queue backed by MySQL.",
  "type": "commonjs",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "keywords": [
    "mysql",
    "queue",
    "worker",
    "resilient",
    "reliable",
    "reliable queue"
  ],
  "author": "necessarylion",
  "repository": {
    "type": "git",
    "url": "https://github.com/necessarylion/oxen-queue-v2"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "mysql2": "3.12.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && node scripts/fixup.js",
    "dev": "tsc -p tsconfig.cjs.json --watch",
    "test": "mocha test/ --timeout 6000 --exit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.10.0",
    "chai": "^4.1.2",
    "mocha": "^5.2.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}